        <Name>Breaker operation time</Name>
        <Description>Opening and closing operation time verification for breaker commissioning.</Description>
        <TestType>operation_time</TestType>
        <MeasurementDefinitions>
          <MeasurementDefinition id="MD-0101" sequence="1" isRequired="true">
            <Code>tripTimeMs</Code>
            <Name>Trip time</Name>
            <Description>Measured opening time of the breaker.</Description>
            <Parameter>trip_time_ms</Parameter>
            <Unit>ms</Unit>
          </MeasurementDefinition>
          <MeasurementDefinition id="MD-0102" sequence="2" isRequired="true">
            <Code>closeTimeMs</Code>
            <Name>Close time</Name>
            <Description>Measured closing time of the breaker.</Description>
            <Parameter>close_time_ms</Parameter>
            <Unit>ms</Unit>
          </MeasurementDefinition>
        </MeasurementDefinitions>
        <EvaluationDefinition id="ED-0002">
          <AggregationMode>manual</AggregationMode>
          <ExpectedUnit>ms</ExpectedUnit>
          <ValidityCriteria>
            <expression>tripTimeMs &lt;= 60</expression>
            <expression>closeTimeMs &lt;= 80</expression>
          </ValidityCriteria>
        </EvaluationDefinition>
      </TestDefinition>
