        <Code>TR_WDG_RES</Code>
        <Name>Transformer winding resistance</Name>
        <Description>Acceptance test for phase winding resistance and phase imbalance.</Description>
        <TestType>winding_resistance</TestType>
        <MeasurementDefinitions>
          <MeasurementDefinition id="MD-0001" sequence="1" isRequired="true">
            <Code>R_ab_mOhm</Code>
            <Name>Phase A-B resistance</Name>
            <Description>Measured resistance between phases A and B.</Description>
            <Parameter>phase_ab_resistance</Parameter>
            <Unit>mOhm</Unit>
          </MeasurementDefinition>
          <MeasurementDefinition id="MD-0002" sequence="2" isRequired="true">
            <Code>R_bc_mOhm</Code>
            <Name>Phase B-C resistance</Name>
            <Description>Measured resistance between phases B and C.</Description>
            <Parameter>phase_bc_resistance</Parameter>
            <Unit>mOhm</Unit>
          </MeasurementDefinition>
          <MeasurementDefinition id="MD-0003" sequence="3" isRequired="true">
            <Code>R_ca_mOhm</Code>
            <Name>Phase C-A resistance</Name>
            <Description>Measured resistance between phases C and A.</Description>
            <Parameter>phase_ca_resistance</Parameter>
            <Unit>mOhm</Unit>
          </MeasurementDefinition>
          <MeasurementDefinition id="MD-0004" sequence="4" isRequired="true">
            <Code>ambientTempC</Code>
            <Name>Ambient temperature</Name>
            <Description>Ambient temperature during measurement acquisition.</Description>
            <Parameter>ambient_temperature</Parameter>
            <Unit>C</Unit>
          </MeasurementDefinition>
          <MeasurementDefinition id="MD-0005" sequence="5" isRequired="true">
            <Code>maxPhaseImbalancePct</Code>
            <Name>Maximum phase imbalance</Name>
            <Description>Maximum percentage imbalance across phase resistances.</Description>
            <Parameter>max_phase_imbalance_pct</Parameter>
            <Unit>%</Unit>
          </MeasurementDefinition>
        </MeasurementDefinitions>
        <EvaluationDefinition id="ED-0001">
          <AggregationMode>representative</AggregationMode>
          <RepresentativeSource>max_phase_imbalance_pct</RepresentativeSource>
          <ExpectedUnit>%</ExpectedUnit>
          <ValidityCriteria>
            <expression>ambientTempC &gt;= 15</expression>
            <expression>ambientTempC &lt;= 35</expression>
            <expression>maxPhaseImbalancePct &lt;= 2.0</expression>
          </ValidityCriteria>
        </EvaluationDefinition>
      </TestDefinition>
