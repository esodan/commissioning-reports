<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:commissioning:export:1.0"
           xmlns="urn:commissioning:export:1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:element name="Export" type="ExportType"/>

  <xs:complexType name="ExportType">
    <xs:sequence>
      <xs:element name="Header" type="ExportHeaderType"/>
      <xs:element name="Records" type="RecordsType"/>
    </xs:sequence>
    <xs:attribute name="formatVersion" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ExportHeaderType">
    <xs:sequence>
      <xs:element name="ExportId" type="xs:string"/>
      <xs:element name="GeneratedAt" type="xs:dateTime"/>
      <xs:element name="Environment" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RecordsType">
    <xs:sequence>
      <xs:element name="Record" type="RecordType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RecordType">
    <xs:sequence>
      <xs:element name="RecordId" type="xs:string"/>
      <xs:element name="EntityType" type="xs:string"/>
      <xs:element name="Payload" type="xs:string"/>
      <xs:element name="Checksum" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
